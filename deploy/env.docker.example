# Tone production environment injection (metadata + runtime secrets).
# Used with: docker compose --env-file .env.docker up --build -d
#
# Local working copy: deploy/.env.docker (gitignored). Never commit it.
# Sync to the server:
#   ./deploy/sync-env-remote.sh              # dry-run
#   ./deploy/sync-env-remote.sh --apply     # writes /srv/apps/tone/.env.docker
#
# Classification:
#   PUBLIC BUILD-TIME — NEXT_PUBLIC_* only (may be baked into the client bundle)
#   PRIVATE RUNTIME   — all other vars below (injected only via env_file at container start)
#
# Leave Flux / OAuth / R2 empty until Justin fills them after flux init.
# The tuner boots without those; login and persistence fail closed.

# --- Public build-time / branding ---
NEXT_PUBLIC_APP_NAME=Tone
NEXT_PUBLIC_APP_TAGLINE=Open the site, play a string, tune the guitar.
NEXT_PUBLIC_APP_URL=https://tone.vsl-base.com

# --- Private runtime: Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://tone.vsl-base.com
NEXTAUTH_URL=https://tone.vsl-base.com
# AUTH_DEV_LOGIN is local-only. Production must be 0/unset.
AUTH_DEV_LOGIN=0

# GitHub / Google OAuth optional until credentials exist; production login fails closed when absent.
# Callbacks:
#   https://tone.vsl-base.com/api/auth/callback/github
#   https://tone.vsl-base.com/api/auth/callback/google
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Private runtime: Flux / PostgREST ---
# Fill after `flux login` + `flux init` for slug tone. Do not invent a hash.
# FLUX_URL from `flux project credentials` / `flux list`.
# FLUX_POSTGREST_SCHEMA from `pnpm flux:schema:sync` (do not put an empty key in .env).
FLUX_URL=
FLUX_GATEWAY_JWT_SECRET=
FLUX_POSTGREST_SCHEMA=
FLUX_TLS_INSECURE=0

# --- Optional R2 (recordings). Leave empty; never required to tune. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
